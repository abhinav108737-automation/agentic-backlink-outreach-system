APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://backlink:backlink@localhost:55432/backlink
# Qdrant always listens on 6333 inside the container. QDRANT_HOST_PORT remaps only the
# dev-compose host port when 6333 is already taken; keep QDRANT_URL's port in sync with it.
QDRANT_HOST_PORT=6333
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
REAL_SEND_ENABLED=false
AUTONOMY_MODE=shadow
DEFAULT_DAILY_SEND_LIMIT=25
EMAIL_PROVIDER=mock
SEO_METRICS_PROVIDER=mock
SEARCH_PROVIDER=mock
CRAWLER_PROVIDER=mock
