{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noUncheckedIndexedAccess": true, "noImplicitOverride": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "types": ["node"]
  },
  "include": ["src", "tests", "electron.vite.config.ts", "vitest.config.ts"]
}
